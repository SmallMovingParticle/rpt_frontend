# Required server-side connection to the companion RPT backend.
DASHBOARD_API_ORIGIN=http://localhost:8000
DASHBOARD_API_TOKEN=replace-with-a-long-random-server-to-server-token

# Production staff access control.
DASHBOARD_ALLOWED_EMAILS=staff@example.com

# Local authentication bypass only; the UI never loads showcase lead fixtures.
DASHBOARD_ALLOW_LOCAL_DEMO=false
