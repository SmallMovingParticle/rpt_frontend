# Server-side connection to the RPT backend. Must be HTTPS in production.
DASHBOARD_API_ORIGIN=https://stride.aibolt.ai
# Must match VAPI-side DASHBOARD_API_TOKEN in the backend .env exactly.
DASHBOARD_API_TOKEN=replace-with-the-backend-dashboard-token

# Staff sign-in. Only these addresses may sign in; empty denies everyone.
DASHBOARD_ALLOWED_EMAILS=staff@example.com,another@example.com
# Shared staff password. Minimum 12 characters.
DASHBOARD_STAFF_PASSWORD=replace-with-a-long-shared-staff-password
# Signs the session cookie. Minimum 32 characters: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=replace-with-openssl-rand-hex-32
