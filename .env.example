# Server-side connection to the RPT backend. Must be HTTPS in production.
DASHBOARD_API_ORIGIN=https://stride.aibolt.ai
# Must match VAPI-side DASHBOARD_API_TOKEN in the backend .env exactly.
DASHBOARD_API_TOKEN=replace-with-the-backend-dashboard-token

# Server-only dashboard users. Use exactly one super_admin; passwords need 12+ characters.
# Optional email enables email login while the short ID stays stable for lead ownership/activity.
# Never expose this value with a NEXT_PUBLIC_ prefix.
DASHBOARD_USERS_JSON='[{"id":"admin","email":"admin@example.test","name":"Practice Administrator","password":"replace-with-a-strong-admin-password","role":"super_admin"},{"id":"employee1","email":"employee1@example.test","name":"Employee 1","password":"replace-with-a-strong-employee-password","role":"employee"}]'
# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
